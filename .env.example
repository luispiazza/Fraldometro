# Na Vercel, as variáveis vêm da integração Supabase (prefixo DATABASE_) e não precisam de ajuste.
#
# No Mac, `vercel env pull` traz essas variáveis mascaradas ("[SENSITIVE]"), então use os
# nomes curtos abaixo em .env.development.local, que o pull não sobrescreve.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Session pooler (porta 5432), no botão "Connect" do Supabase.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DIRECT_DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Token pessoal do Supabase, só para `npm run auth:configurar` (https://supabase.com/dashboard/account/tokens).
SUPABASE_ACCESS_TOKEN=

# Resend, para o envio dos e-mails de acesso (`npm run auth:configurar`).
RESEND_API_KEY=
EMAIL_REMETENTE=
