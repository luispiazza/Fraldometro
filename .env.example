# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings > API e Project Settings > Database).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Pooler em modo transaction (porta 6543), usado pelo app na Vercel.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Conexão direta (porta 5432), usada só pelas migrações.
DIRECT_DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
