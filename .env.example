# Na Vercel, as variáveis vêm da integração Supabase (prefixo DATABASE_) e não precisam de ajuste.
#
# No Mac, `vercel env pull` traz essas variáveis mascaradas ("[SENSITIVE]"), então use os
# nomes curtos abaixo em .env.development.local, que o pull não sobrescreve.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Session pooler (porta 5432), no botão "Connect" do Supabase.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DIRECT_DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Token pessoal do Supabase, só para `npm run auth:configurar` (https://supabase.com/dashboard/account/tokens).
SUPABASE_ACCESS_TOKEN=

# Resend, para o envio dos e-mails de acesso (`npm run auth:configurar`).
RESEND_API_KEY=
EMAIL_REMETENTE=

# Mercado Pago (pagamentos, modelo marketplace). Credenciais da aplicação do Fraldômetro em
# https://www.mercadopago.com.br/developers/panel/app > Credenciais. Em teste, use as de teste.
MP_AMBIENTE=teste   # teste | producao
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Assinatura secreta dos webhooks (painel da aplicação > Webhooks). Opcional, mas recomendado.
MP_WEBHOOK_SECRET=
# Endereço público do site (https), para a volta do OAuth e o webhook. Na Vercel, cai no domínio de
# produção se ficar vazio. Cadastre <SITE_URL>/painel/mercadopago/retorno em "URLs de redirecionamento".
SITE_URL=

# Cifra os tokens do Mercado Pago de cada família guardados no banco (gere com: openssl rand -base64 32).
# Use a mesma em todos os ambientes que leem o mesmo banco.
CHAVE_CIFRA=
