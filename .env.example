# Na Vercel, as variáveis vêm da integração Supabase (prefixo DATABASE_) e não precisam de ajuste.
#
# No Mac, `vercel env pull` traz essas variáveis mascaradas ("[SENSITIVE]"), então use os
# nomes curtos abaixo em .env.development.local, que o pull não sobrescreve.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Session pooler (porta 5432), no botão "Connect" do Supabase.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DIRECT_DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Token pessoal do Supabase, só para `npm run auth:configurar` (https://supabase.com/dashboard/account/tokens).
SUPABASE_ACCESS_TOKEN=

# Resend, para o envio dos e-mails de acesso (`npm run auth:configurar`).
RESEND_API_KEY=
EMAIL_REMETENTE=

# Asaas (pagamentos). Chave da conta do Fraldômetro (precisa ser CNPJ); no sandbox começa com $aact_hmlg_.
# Crie a conta de testes em https://sandbox.asaas.com e gere a chave em Integrações > Chaves de API.
ASAAS_AMBIENTE=sandbox   # sandbox | producao
ASAAS_API_KEY=
# Token que o Asaas manda no cabeçalho asaas-access-token dos webhooks (gere com: openssl rand -hex 32).
ASAAS_WEBHOOK_TOKEN=
# Endereço público do site, para o webhook. Na Vercel, cai no domínio de produção se ficar vazio.
SITE_URL=

# Cifra a chave de API de cada subconta guardada no banco (gere com: openssl rand -base64 32).
# Use a mesma em todos os ambientes que leem o mesmo banco.
CHAVE_CIFRA=
