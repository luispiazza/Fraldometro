# Estas variáveis vêm da integração Supabase da Vercel (prefixo DATABASE).
# Para tê-las localmente, rode `vercel env pull .env.local` em vez de copiar à mão.
# O código só usa as quatro abaixo; as demais da integração podem ficar como estão.

NEXT_PUBLIC_DATABASE_SUPABASE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_DATABASE_SUPABASE_SUPABASE_PUBLISHABLE_KEY=

# Pooler em modo transaction (porta 6543), usado pelo app.
DATABASE_POSTGRES_URL=postgres://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Conexão direta (porta 5432), usada só pelas migrações.
DATABASE_POSTGRES_URL_NON_POOLING=postgres://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
